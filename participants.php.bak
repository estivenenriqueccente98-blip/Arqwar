        <form method="post" id="participantForm">
          <input type="hidden" name="csrf" value="<?= e(csrf_token()) ?>">
          <input type="hidden" name="action" value="create">

          <label class="form-label">Alias competitivo</label>
          <input class="form-control form-control-lg mb-3" name="alias" required placeholder="Ej.: Luis">

          <label class="form-label">Nombre</label>
          <input class="form-control mb-3" name="full_name" placeholder="Opcional">

          <label class="form-label">Especialidad</label>
          <input class="form-control mb-3" name="specialty" placeholder="Ej.: Data Engineer">

          <label class="form-label">Avatar</label>
          <input type="hidden" name="avatar_emoji" id="avatarEmojiInput" value="cyber_skull">

          <div class="avatar-picker mb-2" id="avatarPicker">
            <?php foreach ($avatarOptions as $i => $avatarKey): ?>
              <?php $meta = $avatarCatalog[$avatarKey]; ?>
              <button
                type="button"
                class="avatar-option <?= $i === 0 ? 'active' : '' ?>"
                data-avatar="<?= e($avatarKey) ?>"
                aria-label="<?= e($meta['name']) ?>"
                title="<?= e($meta['name']) ?>"
              >
                <span class="avatar-code"><?= e($meta['tag']) ?></span>
                <span class="avatar-art"><?= arqwar_avatar_svg($avatarKey) ?></span>
                <span class="avatar-name"><?= e($meta['name']) ?></span>
              </button>
            <?php endforeach; ?>
          </div>

          <div class="small text-secondary mb-3">
            Selecciona un icono para el jugador. Podrás cambiarlo luego desde el panel administrativo.
