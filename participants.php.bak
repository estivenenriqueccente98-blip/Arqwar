  <div class="row g-4">

    <div class="col-xl-4">
      <section class="panel p-4 arq-card depth-card">
        <div class="eyebrow">PASO PREVIO A LOS EQUIPOS</div>
        <h1 class="h3">Registrar participante fijo</h1>
