            $avatarKey = arqwar_avatar_key($p['avatar_emoji'] ?: 'cyber_skull');
          ?>
          <article class="participant-card arq-card depth-card">
            <div class="participant-avatar avatar-badge">
              <span class="avatar-art"><?= arqwar_avatar_svg($avatarKey) ?></span>
            </div>

            <div class="flex-grow-1">
              <div class="d-flex justify-content-between gap-2 flex-wrap">
                <div>
                  <h3><?= e($p['alias']) ?></h3>
                  <p><?= e($p['specialty'] ?: 'Sin especialidad') ?></p>
                </div>
                <div class="participant-level">
                  <span><?= e($p['level']['icon']) ?></span>
                  <b><?= e($p['level']['name']) ?></b>
                </div>
              </div>

              <div class="participant-stats">
                <span>Puntos <b><?= $p['total_points'] ?></b></span>
                <span>Respuestas <b><?= $p['answers'] ?></b></span>
                <span>Pronunciación <b><?= $p['pronunciation_hits'] ?></b></span>
              </div>
            </div>
          </article>
        <?php endforeach; ?>
      </div>
    </div>

  </div>
</main>

<script>
document.querySelectorAll('#avatarPicker .avatar-option').forEach(btn => btn.addEventListener('click', () => {
  document.querySelectorAll('#avatarPicker .avatar-option').forEach(x => x.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('avatarEmojiInput').value = btn.dataset.avatar || 'cyber_skull';
}));
</script>

