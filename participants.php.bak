        '🎮' => 'neon_serpent',
        '🏆' => 'holo_trophy',
    ];
}

function arqwar_avatar_key(string $value): string
{
    $catalog = arqwar_avatar_catalog();
    $legacy = arqwar_avatar_legacy_map();
    $value = trim($value);

    if (isset($catalog[$value])) {
        return $value;
    }

    if (isset($legacy[$value])) {
        return $legacy[$value];
    }

    return 'cyber_skull';
}

function arqwar_avatar_meta(string $value): array
{
    $catalog = arqwar_avatar_catalog();
    $key = arqwar_avatar_key($value);
    return $catalog[$key];
}

