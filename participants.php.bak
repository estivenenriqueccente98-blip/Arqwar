$avatarCatalog = arqwar_avatar_catalog();
$avatarOptions = array_keys($avatarCatalog);

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        if (!hash_equals(csrf_token(), $_POST['csrf'] ?? '')) {
            throw new RuntimeException('Solicitud inválida.');
        }

        $a = $_POST['action'] ?? '';

        if ($a === 'create') {
            $alias = trim($_POST['alias'] ?? '');
            $name = trim($_POST['full_name'] ?? '');
            $specialty = trim($_POST['specialty'] ?? '');
            $emoji = arqwar_avatar_key($_POST['avatar_emoji'] ?? 'cyber_skull');

            if (strlen($alias) < 2) {
                throw new RuntimeException('El alias debe tener al menos 2 caracteres.');
            }

            exec_sql(
                'INSERT INTO participants(alias,full_name,specialty,avatar_emoji) VALUES(?,?,?,?)',
                [$alias, $name ?: null, $specialty ?: null, $emoji ?: 'cyber_skull']
            );

            header('Location: participants.php?created=1');
            exit;
        }

        if ($a === 'toggle') {
            if (!is_admin()) {
                throw new RuntimeException('Solo el administrador puede cambiar el estado de participantes.');
            }

            exec_sql(
                'UPDATE participants SET is_active=? WHERE id=?',
                [(int)($_POST['active'] ?? 0), (int)$_POST['id']]
            );

            header('Location: participants.php?updated=1');
            exit;
        }
    } catch (Throwable $e) {
        $error = $e->getMessage();
    }
}

if (isset($_GET['created'])) $msg = 'Participante creado.';
if (isset($_GET['updated'])) $msg = 'Participante actualizado.';

$people = [];
try {
    $people = participant_ranking_rows();
} catch (Throwable $e) {
    $error = $e->getMessage();
}
?>
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ARQWAR · Participantes</title>
<link href="assets/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="assets/css/app.css">

<style>
  /* =========================
     SOLO DISEÑO DE AVATARES
  ========================== */

  .avatar-picker{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:12px;
  }

  @media (max-width: 1200px){
    .avatar-picker{
      grid-template-columns:repeat(3,minmax(0,1fr));
    }
  }

  @media (max-width: 576px){
    .avatar-picker{
      grid-template-columns:repeat(2,minmax(0,1fr));
    }
  }

  .avatar-option{
    position:relative;
    min-height:126px;
    border:1px solid rgba(27,196,255,.22);
    border-radius:12px;
    background:
      linear-gradient(180deg, rgba(8,18,42,.95), rgba(3,11,26,.98));
    box-shadow:
      inset 0 0 0 1px rgba(81,230,255,.04),
      0 0 16px rgba(0,157,255,.08);
    padding:8px 10px 12px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    align-items:center;
    overflow:hidden;
    transition:.25s ease;
    color:#a9efff;
  }

  .avatar-option::before{
    content:'';
    position:absolute;
    inset:0;
    background:
      linear-gradient(rgba(23,157,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23,157,255,.05) 1px, transparent 1px);
    background-size:100% 14px, 14px 100%;
    pointer-events:none;
    opacity:.55;
  }

  .avatar-option::after{
    content:'';
    position:absolute;
    left:10px;
    right:10px;
    bottom:0;
    height:3px;
    border-radius:999px;
    background:linear-gradient(90deg, transparent, #0fe3ff, transparent);
    box-shadow:0 0 10px rgba(15,227,255,.55);
    opacity:.9;
  }

  .avatar-option:hover{
    transform:translateY(-2px);
    border-color:rgba(58,224,255,.45);
    box-shadow:
      inset 0 0 0 1px rgba(81,230,255,.08),
      0 0 18px rgba(15,227,255,.16);
  }

  .avatar-option.active{
    border-color:#ffc400;
    box-shadow:
      inset 0 0 0 1px rgba(255,209,46,.16),
      0 0 20px rgba(255,196,0,.25);
    background:
      linear-gradient(180deg, rgba(47,37,8,.92), rgba(21,15,5,.98));
  }

  .avatar-option.active::after{
    background:linear-gradient(90deg, transparent, #ffd24a, transparent);
    box-shadow:0 0 12px rgba(255,210,74,.7);
  }

  .avatar-code{
    width:100%;
    text-align:left;
    font-size:11px;
    font-weight:700;
    letter-spacing:.8px;
    color:#6dc9ff;
    opacity:.9;
    position:relative;
    z-index:2;
  }

  .avatar-option.active .avatar-code{
    color:#ffd24a;
  }

  .avatar-art{
    width:52px;
    height:52px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#19E3FF;
    filter:
      drop-shadow(0 0 8px rgba(25,227,255,.32))
      drop-shadow(0 0 12px rgba(25,227,255,.18));
    position:relative;
    z-index:2;
  }

  .avatar-option.active .avatar-art{
    color:#19E3FF;
    filter:
      drop-shadow(0 0 8px rgba(25,227,255,.4))
      drop-shadow(0 0 16px rgba(255,196,0,.22));
  }

  .avatar-art svg{
    width:100%;
    height:100%;
    display:block;
  }

  .avatar-name{
    width:100%;
    text-align:center;
    font-size:12.5px;
    font-weight:700;
    color:#dff9ff;
    line-height:1.15;
    position:relative;
    z-index:2;
  }

  .avatar-option.active .avatar-name{
    color:#fff2b0;
  }

  .participant-avatar.avatar-badge{
    width:84px;
    height:84px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(27,196,255,.25);
    background:
      radial-gradient(circle at 30% 25%, rgba(120,68,255,.28), transparent 48%),
      linear-gradient(180deg, rgba(15,29,66,.95), rgba(8,16,36,.98));
    box-shadow:
      inset 0 0 0 1px rgba(81,230,255,.04),
      0 0 14px rgba(0,157,255,.08);
    overflow:hidden;
    flex-shrink:0;
    position:relative;
  }

  .participant-avatar.avatar-badge::after{
    content:'';
    position:absolute;
    left:10px;
    right:10px;
    bottom:8px;
    height:2px;
    border-radius:999px;
    background:linear-gradient(90deg, transparent, rgba(15,227,255,.95), transparent);
    box-shadow:0 0 8px rgba(15,227,255,.4);
  }

  .participant-avatar .avatar-art{
    width:46px;
    height:46px;
    margin-top:-4px;
  }

  .participant-avatar .avatar-art svg{
    width:100%;
    height:100%;
  }
</style>
</head>
